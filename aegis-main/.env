# AEGIS FLOOD v2.0 - Local Environment Configuration

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_AGENT_MODEL=gpt-5.6-luna
OPENAI_AGENT_REASONING_EFFORT=medium
OPENAI_AGENT_TIMEOUT_SECONDS=30
OPENAI_AGENT_MAX_RETRIES=2

# Agent Mode: REAL (uses gpt-5.6-luna API when key present) or SIMULATION (rule-based fallback)
AGENT_MODE=REAL
