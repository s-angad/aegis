# AEGIS FLOOD v2.0 - Environment Configuration

# OpenAI API Configuration (Backend Only - NEVER expose to frontend or git)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_AGENT_MODEL=gpt-5.6-luna
OPENAI_AGENT_REASONING_EFFORT=medium
OPENAI_AGENT_TIMEOUT_SECONDS=30
OPENAI_AGENT_MAX_RETRIES=2

# Agent Intelligence Execution Mode: REAL (Calls GPT-5.6 Luna API) | SIMULATION (Rule-based state machine)
AGENT_MODE=REAL
